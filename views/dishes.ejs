<%- include ('./partials/header') %>

  <main>
    <section class="page-hero" id="hero">
      <div class="site-layout__container">
        <div class="page-hero__content">


          <h1>Naše nabídka</h1>
          <p>Zde najdete naši nabídku </p>

        </div>
      </div>
    </section>

    <section class="dish-catalog__filters">
      <div class="dish-catalog__filter-container">
        <ul class="dish-catalog__filter-list" id="meals">

          <li class="dish-catalog__filter-item dish-catalog__filter-item--all" id="all">Vše</li>
          <li class="dish-catalog__filter-item dish-catalog__filter-item--category" id="3">Hlavní chody</li>
          <li class="dish-catalog__filter-item dish-catalog__filter-item--category" id="4">Rizota a těstoviny</li>
          <li class="dish-catalog__filter-item dish-catalog__filter-item--category" id="1">Předkrmy</li>
          <li class="dish-catalog__filter-item dish-catalog__filter-item--category" id="2">Polévky</li>
          <li class="dish-catalog__filter-item dish-catalog__filter-item--category" id="5">Dezerty</li>
        </ul>
      </div>

    </section>



    <section class="dish-catalog__results" id="dishes">

      <div id="dishes-data" data-dishes="<%= JSON.stringify(dishes) %>">
      </div>






    </section>

  </main>


  <%- include ('./partials/footer') %>
