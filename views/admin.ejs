<%- include ('./partials/header') %>

  <main>

    <section class="page-hero" id="hero">
      <div class="site-layout__container">
        <div class="page-hero__content">


          <h1>Administrace</h1>


        </div>
      </div>
    </section>
    <section>
      <div class="site-layout__container" id="addNew-container">

      </div>
    </section>


    <section class="admin-menu__list admin-menu__list--default" id="list">
      <div class="site-layout__container" id="list-container">


        <div class="admin-menu__add">
          <button class="admin-menu__add-button" id="addNewBtn">
            Přidej novou položku
          </button>
        </div>


        <!-- Add new dish modal -->

        <div class="admin-modal" id="addDishModal">
          <div class="admin-modal__content" role="dialog" aria-modal="true" aria-labelledby="addDishTitle">


            <div class="admin-modal__header">
              <h2 id="addDishTitle" class="admin-modal__title">Přidej novou položku</h2>
              <button class="admin-modal__close-button" id="closeModal" type="button"
                aria-label="Zavřít">&times;</button>

            </div>

            <form id="addDishForm" class="admin-dish-form" method="POST" action="/addDish">
              <p class="admin-dish-form__message" aria-live="polite"></p>

              <label for="addDishName">Název</label>
              <input id="addDishName" name="name" type="text" required>

              <label for="addDishDescription">Popis</label>
              <textarea id="addDishDescription" name="description" rows="4" required></textarea>

              <label for="addDishPrice">Cena</label>
              <input id="addDishPrice" name="price" type="number" min="0" step="0.01" required>

              <label for="addDishCategory">Kategorie</label>
              <select id="addDishCategory" name="category_id" required>

                <option value="" selected>Vyberte kategorii</option>


                <% categories.forEach(category=> { %>
                  <option value="<%= category.id %>">
                    <%= category.name %>
                  </option>
                  <% }) %>


              </select>


              <button class="admin-dish-form__submit" type="submit">Uložit položku</button>

            </form>


          </div>
        </div>

        <!-- Edit dish modal -->

        <div class="admin-modal" id="editDishModal">
          <div class="admin-modal__content" role="dialog" aria-modal="true" aria-labelledby="editDishTitle">

            <div class="admin-modal__header">
              <h2 id="editDishTitle" class="admin-modal__title">Upravit položku</h2>
              <button class="admin-modal__close-button" id="closeEditModal" type="button"
                aria-label="Zavřít">&times;</button>
            </div>

            <form id="editDishForm" class="admin-dish-form" method="POST" action="">
              <p class="admin-dish-form__message" aria-live="polite"></p>

              <label for="editDishName">Název</label>
              <input id="editDishName" name="name" type="text" required>

              <label for="editDishDescription">Popis</label>
              <textarea id="editDishDescription" name="description" rows="4" required></textarea>

              <label for="editDishPrice">Cena</label>
              <input id="editDishPrice" name="price" type="number" min="0" step="0.01" required>

              <label for="editDishCategory">Kategorie</label>
              <select id="editDishCategory" name="category_id" required>
                <option value="" selected>Vyberte kategorii</option>

                <% categories.forEach(category=> { %>
                  <option value="<%= category.id %>">
                    <%= category.name %>
                  </option>
                  <% }) %>
              </select>

              <button class="admin-dish-form__submit" type="submit">Uložit změny</button>
            </form>
          </div>
        </div>

        <!-- Delete confirmation modal -->

        <div class="admin-modal" id="deleteModal">

          <div class="admin-modal__content" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">

            <div class="admin-modal__header">
              <div></div>
              <button class="admin-modal__close-button" id="closeDeleteModal" type="button"
                aria-label="Zavřít">&times;</button>

            </div>
            <h2 id="deleteModalTitle" class="admin-modal__title">Opravdu chcete smazat tuto položku?</h2>





            <div class="admin-modal__actions">

              <button class="admin-modal__action-button" id="confirmDelete" type="button">
                Ano
              </button>

              <button class="admin-modal__action-button" id="cancelDelete" type="button">
                Ne
              </button>

            </div>
          </div>
        </div>

        <!-- List of dishes cards -->

        <% if (dishes && dishes.length> 0) { %>

          <% dishes.forEach(d=> { %>

            <div class="admin-dish">
              <div class="admin-dish__details">
                <div class="admin-dish__field admin-dish__field--text">
                  <label for="title" class="admin-dish__label">Nazev</label>
                  <div class="admin-dish__value admin-dish__value--title">
                    <%=d.name%>
                  </div>
                </div>

                <div class="admin-dish__field admin-dish__field--text admin-dish__field--description">
                  <label for="description" class="admin-dish__label">Popis</label>
                  <div class="admin-dish__value admin-dish__value--description">
                    <%=d.description%>
                  </div>
                </div>

                <div class="admin-dish__field admin-dish__field--text">
                  <label for="price" class="admin-dish__label">Cena</label>
                  <div class="admin-dish__value">
                    <%=d.price%>
                  </div>
                </div>

                <div class="admin-dish__field admin-dish__field--text">
                  <label for="category" class="admin-dish__label">Kategorie</label>
                  <div class="admin-dish__value">
                    <%=d.category%>
                  </div>
                </div>

                <div class="admin-dish__actions">
                  <button class="admin-dish__icon-button admin-dish__edit-button" type="button" data-id="<%= d.id %>"
                    data-name="<%= d.name %>" data-description="<%= d.description %>" data-price="<%= d.price %>"
                    data-category-id="<%= d.category_id %>">
                    <span class="material-icons">
                      edit
                    </span>
                  </button>

                  <form action="/admin/<%= d.id %>/delete" method="post">
                    <button class="admin-dish__icon-button admin-dish__delete-button" type="submit">
                      <span class="material-icons">
                        delete
                      </span>
                    </button>
                  </form>
                </div>
              </div>
            </div>








            <% }) %>

              <% } else { %>

                <p class="list__empty-message">Zatím je naše menu prázdné</p>

                <% } %>

    </section>




  </main>
  <%- include ('./partials/footer') %>
