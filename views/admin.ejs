<%- include ('./partials/header') %>

  <main>

    <section class="hero" id="hero">
      <div class="container">
        <div class="hero-content">


          <h1>Administrace</h1>


        </div>
      </div>
    </section>
    <section>
      <div class="container" id="addNew-container">

      </div>
    </section>


    <section class="list default" id="list">
      <div class="container" id="list-container">


        <div class="addNew">
          <button class="addNewBtn" id="addNewBtn">
            Přidej novou položku
          </button>
        </div>


        <!-- Add new dish modal -->

        <div class="modal" id="addDishModal" aria-hidden="true">
          <div class="modalContent" role="dialog" aria-modal="true" aria-labelledby="addDishTitle">


            <div class="modalTop">
              <h2 id="addDishTitle" class="modalTitle">Přidej novou položku</h2>
              <button class="closeModalCrossBtn" id="closeModal" type="button" aria-label="Zavřít">&times;</button>

            </div>

            <form id="addDishForm" class="addDishForm" method="POST" action="/addDish">
              <p class="form-message" aria-live="polite"></p>

              <label for="addDishName">Název</label>
              <input id="addDishName" name="name" type="text" required>

              <label for="addDishDescription">Popis</label>
              <textarea id="addDishDescription" name="description" rows="4" required></textarea>

              <label for="addDishPrice">Cena</label>
              <input id="addDishPrice" name="price" type="number" min="0" step="0.01" required>

              <label for="addDishCategory">Kategorie</label>
              <select id="addDishCategory" name="category_id" required>

                <option value="" selected>Vyberte kategorii</option>


                <% categories.forEach(category=> { %>
                  <option value="<%= category.id %>">
                    <%= category.name %>
                  </option>
                  <% }) %>
              </select>


              <button class="saveDish" type="submit">Uložit položku</button>

            </form>


          </div>
        </div>

        <!-- Edit dish modal -->

        <div class="modal" id="editDishModal" aria-hidden="true">
          <div class="modalContent" role="dialog" aria-modal="true" aria-labelledby="editDishTitle">

            <div class="modalTop">
              <h2 id="editDishTitle" class="modalTitle">Upravit položku</h2>
              <button class="closeModalCrossBtn" id="closeEditModal" type="button" aria-label="Zavřít">&times;</button>
            </div>

            <form id="editDishForm" class="addDishForm" method="POST" action="">
              <p class="form-message" aria-live="polite"></p>

              <label for="editDishName">Název</label>
              <input id="editDishName" name="name" type="text" required>

              <label for="editDishDescription">Popis</label>
              <textarea id="editDishDescription" name="description" rows="4" required></textarea>

              <label for="editDishPrice">Cena</label>
              <input id="editDishPrice" name="price" type="number" min="0" step="0.01" required>

              <label for="editDishCategory">Kategorie</label>
              <select id="editDishCategory" name="category_id" required>
                <option value="" selected>Vyberte kategorii</option>

                <% categories.forEach(category=> { %>
                  <option value="<%= category.id %>">
                    <%= category.name %>
                  </option>
                  <% }) %>
              </select>

              <button class="saveDish" type="submit">Uložit změny</button>
            </form>
          </div>
        </div>

        <!-- Delete confirmation modal -->

        <div class="modal" id="deleteModal" aria-hidden="true">

          <div class="modalContent" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle">

            <div class="modalTop">
              <div></div>
              <button class="closeModalCrossBtn" id="closeDeleteModal" type="button"
                aria-label="Zavřít">&times;</button>

            </div>
            <h2 id="deleteModalTitle" class="modalTitle">Opravdu chcete smazat tuto položku?</h2>





            <div class="deleteModalActions">

              <button class="closeModalBtn" id="confirmDelete" type="button">
                Ano
              </button>

              <button class="closeModalBtn" id="cancelDelete" type="button">
                Ne
              </button>

            </div>
          </div>
        </div>

        <!-- List of dishes cards -->

        <% dishes.forEach(d=> { %>

          <div class="card">
            <div class="desc">
              <div class="title text item">
                <label for="title" class="label">Nazev</label>
                <div class="title">
                  <%=d.name%>
                </div>
              </div>

              <div class="description text item">
                <label for="description" class="label">Popis</label>
                <div class="description">
                  <%=d.description%>
                </div>
              </div>

              <div class="price text item">
                <label for="price" class="label">Cena</label>
                <div class="price">
                  <%=d.price%>
                </div>
              </div>

              <div class="category text item">
                <label for="category" class="label">Kategorie</label>
                <div class="category">
                  <%=d.category%>
                </div>
              </div>

              <div class="icons item">
                <button class="iconBtn editBtn" type="button" data-id="<%= d.id %>" data-name="<%= d.name %>"
                  data-description="<%= d.description %>" data-price="<%= d.price %>"
                  data-category-id="<%= d.category_id %>">
                  <span class="material-icons">
                    edit
                  </span>
                </button>

                <form action="/admin/<%= d.id %>/delete" method="post">
                  <button class="iconBtn deleteBtn" type="submit">
                    <span class="material-icons">
                      delete
                    </span>
                  </button>
                </form>
              </div>
            </div>
          </div>





          <% }) %>



    </section>




  </main>
  <%- include ('./partials/footer') %>
