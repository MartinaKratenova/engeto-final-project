<body>
  <header class="header">
    <div class="container">
      <div class="header-items">
        <div class="big-screen-menu">
          <div class="logo">
            <a href="/">
              <img src="img/logo-nobg.png" alt="Logo">
            </a>
          </div>
          <nav class="menu">
            <ul>
              <li><a href="/">Domů</a> </li>
              <li><a href="/dishes">Nabídka</a> </li>
              <li><a href="/admin">Administrace</a> </li>

            </ul>
          </nav>
