        <div id="myNav" class="overlay">

          <button class="closeNavBtn" id="closeNavBtn" type="button" aria-label="Zavřít">&times;</button>

          <div class="overlay-content">

            <a href="/">Domů</a>
            <a href="/dishes">Nabídka</a>
