<%- include ('./partials/header') %>

  <main>
    <section class="hero" id="hero">
      <div class="container">
        <div class="hero-content">


          <h1>Dobrou chuť</h1>
          <p>Vítejte v naší Skvělé restauraci!</p>

        </div>
      </div>
    </section>
    <section class="our-dishes" id="our-dishes">
