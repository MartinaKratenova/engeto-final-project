<%- include ('./partials/header') %>

  <main>
    <section class="page-hero" id="hero">
      <div class="site-layout__container">
        <div class="page-hero__content">


          <h1>Dobrou chuť</h1>
          <p>Vítejte v naší Skvělé restauraci!</p>

        </div>
      </div>
    </section>
    <section class="home-menu" id="our-dishes">
      <div class="site-layout__container">
        <div class="home-menu__content">

          <div class="home-menu__section" id="dishes">

            <h2>Naše nabídka</h2>

            <p class="home-menu__description">Vyberte si z nabídky předkrmů, polévek, hlavních chodů i dezertů. Najdete
              u nás klasická jídla i oblíbené italské speciality. V naší útulné restauraci, kde si můžete vychutnat
              dobré jídlo, příjemnou atmosféru a chvíli klidu. Připravujeme poctivá jídla z kvalitních surovin a každý
              den myslíme na to, aby vám u nás chutnalo.</p>

            <div class="home-menu__category-list">

              <!-- main course -->
              <div class="home-menu__category home-menu__category--main">
                <a class="home-menu__category-link" href="/dishes?category=3">
                  <img class="home-menu__image" src="img/main-shrimp.jpg" alt="Hlavní jídla">

                  <div class="home-menu__name">

                    Hlavní jídla

                  </div>
                </a>
              </div>
              <!-- smaller dishes  -->
              <div class="home-menu__secondary-list">
                <div class="home-menu__category home-menu__category--small home-menu__category--soups">
                  <a class="home-menu__category-link" href="/dishes?category=2">
                    <img class="home-menu__image" src="img/soup.jpg" alt="Polévky">
                    <div class="home-menu__name">
                      Polévky
                    </div>

                  </a>
                </div>


                <div class="home-menu__category home-menu__category--small home-menu__category--starters">
                  <a class="home-menu__category-link" href="/dishes?category=1">
                    <img class="home-menu__image" src="img/starter.jpg" alt="Předkrmy">
                    <div class="home-menu__name">
                      Předkrmy
                    </div>
                  </a>

                </div>


                <div class="home-menu__category home-menu__category--small home-menu__category--desserts">
                  <a class="home-menu__category-link" href="/dishes?category=5">
                    <img class="home-menu__image" src="img/dessert.jpg" alt="Dezerty">
                    <div class="home-menu__name">
                      Dezerty
                    </div>
                  </a>

                </div>



                <div class="home-menu__category home-menu__category--small home-menu__category--pasta">
                  <a class="home-menu__category-link" href="/dishes?category=4">
                    <img class="home-menu__image" src="img/shrimps.jpg" alt="Rizota a těstoviny">
                    <div class="home-menu__name">
                      Rizota a těstoviny
                    </div>
                  </a>
                </div>



              </div>

            </div>
          </div>
        </div>
      </div>
      </div>
    </section>

  </main>
  <%- include ('./partials/footer') %>
